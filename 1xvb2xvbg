    <script>
        // LANGUAGE TOGGLE
        const langBtns = document.querySelectorAll('.lang-btn');
        const langElements = document.querySelectorAll('[data-en][data-es]');

        function setLanguage(lang) {
            document.documentElement.lang = lang;
            langElements.forEach(el => {
                const text = el.getAttribute('data-' + lang);
                if (text) el.innerHTML = text;
            });
            langBtns.forEach(btn => {
                const isActive = btn.dataset.lang === lang;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
            try { localStorage.setItem('thrivebreak-lang', lang); } catch (e) {}
        }

        langBtns.forEach(btn => {
            btn.addEventListener('click', () => setLanguage(btn.dataset.lang));
        });

        try {
            const savedLang = localStorage.getItem('thrivebreak-lang');
            if (savedLang === 'es') setLanguage('es');
        } catch (e) {}

        // LIVE PRODUCT SEARCH FILTER
        const searchInput = document.getElementById('menuSearch');
        const cards = document.querySelectorAll('.pricing-card');
        const noResults = document.getElementById('noResults');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const term = searchInput.value.toLowerCase().trim();
                let visibleCards = 0;

                cards.forEach(card => {
                    const rows = card.querySelectorAll('tbody tr');
                    let visibleRows = 0;

                    rows.forEach(row => {
                        const productName = row.cells[0].textContent.toLowerCase();
                        const match = productName.includes(term);
                        row.style.display = match ? '' : 'none';
                        if (match) visibleRows++;
                    });

                    card.style.display = visibleRows > 0 ? '' : 'none';
                    if (visibleRows > 0) visibleCards++;
                });

                noResults.style.display = visibleCards === 0 ? 'block' : 'none';
            });
        }

        // FEEDBACK MODAL
        const modal = document.getElementById('feedbackModal');
        const modalClose = document.getElementById('modalClose');
        const feedbackForm = document.getElementById('feedbackForm');
        const feedbackSuccess = document.getElementById('feedbackSuccess');
        const feedbackTypeInput = document.getElementById('feedbackTypeInput');
        const feedbackTypeBtns = document.querySelectorAll('.feedback-type-btn');
        const feedbackTriggers = document.querySelectorAll('.feedback-trigger');

        function openModal(presetType) {
            modal.classList.add('open');
            document.body.style.overflow = 'hidden';
            feedbackForm.style.display = 'block';
            feedbackSuccess.classList.remove('show');
            if (presetType) {
                feedbackTypeBtns.forEach(b => b.classList.remove('selected'));
                const btn = document.querySelector(`.feedback-type-btn[data-type="${presetType}"]`);
                if (btn) {
                    btn.classList.add('selected');
                    feedbackTypeInput.value = presetType;
                }
            }
        }

        function closeModal() {
            modal.classList.remove('open');
            document.body.style.overflow = '';
        }

        feedbackTriggers.forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                openModal(trigger.dataset.type);
            });
        });

        modalClose.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) closeModal(); });

        feedbackTypeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                feedbackTypeBtns.forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                feedbackTypeInput.value = btn.dataset.type;
            });
        });

        feedbackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(feedbackForm);
            try {
                const response = await fetch(feedbackForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });
                if (response.ok) {
                    feedbackForm.style.display = 'none';
                    feedbackSuccess.classList.add('show');
                    feedbackForm.reset();
                    setTimeout(() => { if (modal.classList.contains('open')) closeModal(); }, 3000);
                } else {
                    alert(document.documentElement.lang === 'es' ? 'Hubo un error. Por favor intenta de nuevo.' : 'There was an error. Please try again.');
                }
            } catch (err) {
                alert(document.documentElement.lang === 'es' ? 'Error de conexión.' : 'Connection error.');
            }
        });

        // CONTACT FAB
        const contactFabMain = document.getElementById('contactFabMain');
        const contactFabMenu = document.getElementById('contactFabMenu');

        if (contactFabMain && contactFabMenu) {
            contactFabMain.addEventListener('click', () => {
                const isOpen = contactFabMenu.classList.toggle('open');
                contactFabMain.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.contact-fab-container')) {
                    contactFabMenu.classList.remove('open');
                    contactFabMain.setAttribute('aria-expanded', 'false');
                }
            });
        }
    </script>
